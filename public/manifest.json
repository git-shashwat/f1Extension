{
  "name": "F1 Extension",
  "description": "Base Level Extension",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_title": "Open the popup"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "notifications",
    "alarms",
    "storage"
  ],
  "icons": {
    "16": "F1.png",
    "48": "F1.png",
    "128": "F1.png"
  }
}